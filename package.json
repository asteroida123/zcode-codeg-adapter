{
  "name": "@asteroida123/zcode-codeg-adapter",
  "version": "0.1.0",
  "description": "A pinned, stdio-only ZCode ACP launch profile for Codeg; no protocol fork.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/asteroida123/zcode-codeg-adapter.git"
  },
  "bin": {
    "zcode-codeg": "bin/zcode-codeg.js"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "examples",
    "LICENSE",
    "NOTICE",
    "npm-shrinkwrap.json"
  ],
  "engines": {
    "node": "^22.16.0 || ^24.0.0"
  },
  "scripts": {
    "check": "node --check bin/zcode-codeg.js && node --check src/launcher.js && node scripts/check-backend.mjs",
    "test": "node --test test/unit.test.js test/backend-contract.test.js test/probe.test.js",
    "test:upstream": "node --test test/upstream.test.js",
    "doctor": "node bin/zcode-codeg.js doctor",
    "test:backend": "node --test test/backend-contract.test.js test/probe.test.js",
    "test:mutations": "node scripts/check-backend-mutations.mjs",
    "probe:backend": "node scripts/probe-zcode.mjs"
  },
  "dependencies": {
    "zcode-acp-server": "0.32.0"
  }
}
